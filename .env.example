PORT=3000
AUTH_TOKEN=change-me-to-a-secret

LAUNCH_BROWSER=false
USER_DATA_DIR=./data/chromium-profile
BROWSER_START_URL=https://www.youtube.com
# chrome | msedge — Google Chrome / Edge installed on the PC (recommended for YouTube seek)
# BROWSER_CHANNEL=chrome
PLAYER_MODE=fake
LOAD_EXTENSIONS=false

# Preset — Google Chrome TV (copy to .env; no adblock — breaks YouTube in automation)
# LAUNCH_BROWSER=true
# BROWSER_CHANNEL=chrome
# USER_DATA_DIR=./data/chrome-tv-profile
# LOAD_EXTENSIONS=false
# PLAYER_MODE=youtube
