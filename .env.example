PORT=3000
AUTH_TOKEN=change-me-to-a-secret

# Etapa 2 — Chromium en el monitor (netbook)
LAUNCH_BROWSER=false
USER_DATA_DIR=./data/chromium-profile
BROWSER_START_URL=https://www.youtube.com
# chrome | msedge — Web Store; omit = Chromium de Playwright (solo “Cargar descomprimida”)
# BROWSER_CHANNEL=chrome
# fake | youtube (default: youtube when LAUNCH_BROWSER=true)
PLAYER_MODE=fake
# EXTENSION_PATHS=./extensions/ublock-origin,./extensions/h264ify
# true = carga extensions/* (uBO suele romper YouTube ~40s en Playwright Chromium)
# LOAD_EXTENSIONS=true
